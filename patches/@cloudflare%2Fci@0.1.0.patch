@@ -4,3 +4,7 @@
 export function shellQuote(value: string) {
   return `'${value.replaceAll("'", "'\\''")}'`;
 }
+
+export function redirectCommand(command: string, stdout: string, stderr: string) {
+  return `(\n${command}\n) > ${shellQuote(stdout)} 2> ${shellQuote(stderr)}`;
+}
