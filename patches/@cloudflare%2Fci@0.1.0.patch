diff --git a/src/shared/shell.ts b/src/shared/shell.ts
index fd5fdd095df29ab1c32aea0f94f4c469027c216f..a7f47ab3e12cc8f0d18bc036263c9fe100c0f277 100644
--- a/src/shared/shell.ts
