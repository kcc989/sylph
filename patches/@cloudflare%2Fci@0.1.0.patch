+function* escapedText(text: string) {
+  for (let offset = 0; offset < text.length; offset += 16384) {
+    yield JSON.stringify(text.slice(offset, offset + 16384)).slice(1, -1);
+  }
+}
+
+async function* logText(
+  value: string | ReadableStream<Uint8Array>,
+  readers: Set<ReadableStreamDefaultReader<Uint8Array>>,
+  maxBytes: number
+) {
+  if (typeof value === 'string') {
+    yield* escapedText(value);
+    return;
+  }
+  const reader = value.getReader();
+  readers.add(reader);
+  const decoder = new TextDecoder('utf-8', { fatal: true });
+  try {
+    while (true) {
+      const part = await reader.read();
+      if (part.done) break;
+      if (part.value.byteLength > maxBytes) throw new Error('CI log chunk exceeds persistence limit');
+      yield* escapedText(decoder.decode(part.value, { stream: true }));
+    }
+    yield* escapedText(decoder.decode());
+  } finally {
+    await reader.cancel().catch(() => undefined);
+    reader.releaseLock();
+    readers.delete(reader);
+  }
+}
+
+async function cancelLogs(
+  logs: CiRunnerLogs,
+  readers: Set<ReadableStreamDefaultReader<Uint8Array>>,
+  reason?: unknown
+) {
+  await Promise.all([
+    ...[...readers].map(reader => reader.cancel(reason).catch(() => undefined)),
+    ...[logs.stdout, logs.stderr].map(value =>
+      typeof value !== 'string' && !value.locked
+        ? value.cancel(reason).catch(() => undefined)
+        : Promise.resolve()
+    ),
+  ]);
+}
+
+export function encodeRunnerOutput(
+  output: CiRunStepOutput,
+  maxBytes = maxPersistedRunnerBytes
+): ReadableStream<Uint8Array> {
+  const readers = new Set<ReadableStreamDefaultReader<Uint8Array>>();
+  const encoder = new TextEncoder();
+  const generate = async function* () {
+    const metadata = JSON.stringify({
+      exitCode: output.exitCode,
+      snapshot: output.snapshot,
+      cachePointer: output.cachePointer,
+    });
+    if (metadata.length > 65536) throw new Error('CI result metadata exceeds persistence limit');
+    yield `${metadata.slice(0, -1)},"logs":{"stdout":"`;
+    yield* logText(output.logs.stdout, readers, maxBytes);
+    yield '","stderr":"';
+    yield* logText(output.logs.stderr, readers, maxBytes);
+    yield '"}}';
+  };
+  const iterator = generate();
+  let bytes = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      try {
+        const next = await iterator.next();
+        if (next.done) {
+          controller.close();
+          return;
+        }
+        const chunk = encoder.encode(next.value);
+        bytes += chunk.byteLength;
+        if (bytes > maxBytes) throw new Error(`CI result exceeds ${maxBytes} persisted bytes`);
+        controller.enqueue(chunk);
+      } catch (cause) {
+        controller.error(cause);
+        await cancelLogs(output.logs, readers, cause);
+        await iterator.return(undefined).catch(() => undefined);
+      }
+    },
+    async cancel(reason) {
+      await cancelLogs(output.logs, readers, reason);
+      await iterator.return(undefined).catch(() => undefined);
+    },
+  });
+}
+
+export async function decodeRunnerOutput(
+  output: CiRunStepOutput | ReadableStream<Uint8Array>,
+  maxBytes = maxPersistedRunnerBytes
+): Promise<CiRunStepOutput> {
+  if (!(output instanceof ReadableStream)) return output;
+  const reader = output.getReader();
+  const decoder = new TextDecoder('utf-8', { fatal: true });
+  const parts: string[] = [];
+  let bytes = 0;
+  try {
+    while (true) {
+      const next = await reader.read();
+      if (next.done) break;
+      bytes += next.value.byteLength;
+      if (bytes > maxBytes) throw new Error(`CI result exceeds ${maxBytes} persisted bytes`);
+      parts.push(decoder.decode(next.value, { stream: true }));
+    }
+    parts.push(decoder.decode());
+    return persistedRunnerOutput.parse(JSON.parse(parts.join('')));
+  } finally {
+    await reader.cancel().catch(() => undefined);
+    reader.releaseLock();
+  }
+}
