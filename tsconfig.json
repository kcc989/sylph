{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node", "bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "alchemy.run.ts",
    "oxlint.config.ts",
    "apps/web/src/env.d.ts",
    "tools/runtime-smoke/*.test.ts",
    "tools/browser-smoke/*.ts",
    "tools/deployment/**/*.ts",
    "tools/release-smoke/lifecycle*.ts",
    "tools/release-smoke/preservation*.ts",
    "scripts/lifecycle-proof.ts",
    "tests/release-smoke/actions/*.ts",
    "tests/release-smoke/flow-helpers.ts",
    "scripts/installation-preserve.ts",
    "scripts/deploy-check.ts"
  ]
}
