{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node", "bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "alchemy.run.ts",
    "oxlint.config.ts",
    "apps/web/src/env.d.ts",
    "tools/runtime-smoke/*.test.ts"
  ]
}
