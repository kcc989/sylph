    "@workspace/ui": "workspace:*",
    "fumadocs-core": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.8",
    "lucide-react": "^1.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
