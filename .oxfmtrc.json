{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".alchemy/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.tanstack/**",
    "**/.vinxi/**",
    "**/coverage/**",
    "apps/web/src/routeTree.gen.ts",
    "README.md",
    "pnpm-lock.yaml",
    ".pnpm-store/"
  ]
}
