{
  "name": "sylph",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/kcc989/sylph",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "storybook": "bun --cwd packages/ui storybook",
    "build:storybook": "bun --cwd packages/ui build-storybook",
    "dev": "turbo dev",
    "dev:cloudflare": "bash scripts/prepare-workerd.sh && alchemy dev",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "bun test tools/oxlint/anti-slop/tests tools/wizard/tests tools/release-smoke && turbo test && bun run test:opencode",
    "smoke:release": "node scripts/release-smoke.mjs test",
    "smoke:release:install": "playwright install chromium",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "postinstall": "bash scripts/prepare-workerd.sh",
    "prepare": "lefthook install",
    "test:opencode": "bun test tools/runtime-smoke",
    "smoke:runtime": "node tools/runtime-smoke/run.mjs",
    "smoke:release:doctor": "node scripts/release-smoke.mjs doctor",
    "smoke:release:deploy": "node scripts/release-smoke.mjs deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@types/node": "^26",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "^1.62.1",
    "alchemy": "2.0.0-beta.76",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "turbo": "^2.9.18",
    "typescript": "^6",
    "miniflare": "4.20260730.0",
    "rolldown": "1.2.5"
  },
  "packageManager": "bun@1.2.7",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@cloudflare/ci": "^0.1.0",
    "@cloudflare/sandbox": "0.12.1",
    "effect": "4.0.0-rc.112"
  },
  "patchedDependencies": {
    "@opencode-ai/sdk@0.0.0-dev-18308": "patches/@opencode-ai%2Fsdk@0.0.0-dev-18308.patch",
    "@opencode-ai/core@0.0.0-dev-18308": "patches/@opencode-ai%2Fcore@0.0.0-dev-18308.patch",
    "cursor-opencode-provider@0.6.6": "patches/cursor-opencode-provider@0.6.6.patch",
    "@cloudflare/ci@0.1.0": "patches/@cloudflare%2Fci@0.1.0.patch"
  }
}
