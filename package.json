{
  "name": "sylph",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/kcc989/sylph",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "storybook": "bun --cwd packages/ui storybook",
    "build:storybook": "bun --cwd packages/ui build-storybook",
    "dev": "turbo dev",
    "dev:cloudflare": "alchemy dev",
    "lint": "node scripts/check-dependency-policy.mjs && oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "bun test tools/oxlint/anti-slop/tests tools/wizard/tests tools/deployment tools/release-smoke tools/template-contract && turbo test --log-order=stream && bun run test:opencode",
    "smoke:release": "node scripts/release-smoke.mjs test",
    "smoke:lifecycle": "bun scripts/lifecycle-proof.ts",
    "installation:preserve": "bun scripts/installation-preserve.ts",
    "smoke:release:install": "playwright install chromium",
    "deploy": "alchemy deploy",
    "deploy:check": "bun scripts/deploy-check.ts",
    "destroy": "alchemy destroy",
    "prepare": "lefthook install",
    "test:opencode": "bun test tools/runtime-smoke",
    "smoke:runtime": "node tools/runtime-smoke/run.mjs",
    "smoke:browser": "node tools/browser-smoke/run.mjs",
    "smoke:release:doctor": "node scripts/release-smoke.mjs doctor",
    "smoke:release:deploy": "node scripts/release-smoke.mjs deploy",
    "smoke:release:cleanup": "node scripts/release-smoke.mjs cleanup"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "alchemy": "2.0.0-beta.76",
    "lefthook": "2.1.12",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "rolldown": "1.2.7",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.2.7",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@cloudflare/ci": "^0.1.0",
    "@cloudflare/sandbox": "0.12.9",
    "effect": "4.0.0-rc.112"
  }
}
