{
  "name": "sylph",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": "https://github.com/kcc989/sylph",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "storybook": "bun --cwd packages/ui storybook",
    "build:storybook": "bun --cwd packages/ui build-storybook",
    "dev": "turbo dev",
    "dev:cloudflare": "bash scripts/prepare-workerd.sh && alchemy dev",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "bun test tools/oxlint/anti-slop/tests && turbo test",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "postinstall": "bash scripts/prepare-workerd.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@oxlint/plugins": "1.80.0",
    "alchemy": "2.0.0-beta.74",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.2.7",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.111",
    "effect": "4.0.0-rc.111"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "effect": "4.0.0-rc.111"
  }
}
